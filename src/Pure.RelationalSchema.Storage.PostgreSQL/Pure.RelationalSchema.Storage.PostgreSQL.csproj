<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>Pure.RelationalSchema.Storage.PostgreSQL</PackageId>
    <Description>Meta-package that references the Abstractions, Creation, Querying and Insertion packages of the Pure relational schema PostgreSQL storage. It contains no code.</Description>
    <Authors>Dmitry Kurochkin</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/kudima03/Pure.RelationalSchema.Storage.PostgreSQL</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference
      Include="Pure.RelationalSchema.Storage.PostgreSQL.Abstractions"
      Version="0.1.0-preview.0.1.0"
    />
    <PackageReference
      Include="Pure.RelationalSchema.Storage.PostgreSQL.Creation"
      Version="0.1.0-preview.0.3.1"
    />
    <PackageReference
      Include="Pure.RelationalSchema.Storage.PostgreSQL.Insertion"
      Version="0.1.0-preview.0.3.0"
    />
    <PackageReference
      Include="Pure.RelationalSchema.Storage.PostgreSQL.Querying"
      Version="0.1.0-preview.0.5.0"
    />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
